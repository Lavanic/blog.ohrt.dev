---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Oliver Ohrt's blog." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202E46" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="blog.ohrt.dev" href="/rss.xml" />
    <meta property="og:site_name" content="Oliver Ohrt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="shell">
      <header class="bar box">
        <a href="/">blog.ohrt.dev</a>
          <span>
          <a href="/rss.xml" aria-label="RSS feed" title="RSS feed">
            <svg class="rss-icon" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="rssg" x1="0.085" y1="0.085" x2="0.915" y2="0.915">
                  <stop offset="0" stop-color="#E3702D"/>
                  <stop offset="0.107" stop-color="#EA7D31"/>
                  <stop offset="0.35" stop-color="#F69537"/>
                  <stop offset="0.5" stop-color="#FB9E3A"/>
                  <stop offset="0.702" stop-color="#EA7C31"/>
                  <stop offset="0.887" stop-color="#DE642B"/>
                  <stop offset="1" stop-color="#D95B29"/>
                </linearGradient>
              </defs>
              <rect width="256" height="256" rx="55" fill="#CC5D15"/>
              <rect x="5" y="5" width="246" height="246" rx="50" fill="#F49C52"/>
              <rect x="10" y="10" width="236" height="236" rx="47" fill="url(#rssg)"/>
              <circle cx="68" cy="189" r="24" fill="#FFF"/>
              <path d="M160 213h-34a82 82 0 0 0-82-82V97a116 116 0 0 1 116 116z" fill="#FFF"/>
              <path d="M184 213A140 140 0 0 0 44 73V38a175 175 0 0 1 175 175z" fill="#FFF"/>
            </svg>
          </a>
          &middot; <a href="https://ohrt.dev">ohrt.dev</a>
        </span>
      </header>
      <main class="box">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 28px 18px 18vh;
    background: #202E46;
    font-family: "MS UI Gothic", "MS PGothic", sans-serif;
  }

  .shell {
    max-width: 44rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .box {
    box-shadow:
      0 0 0 1.5px rgb(0, 15, 149),
      0 0 0 3px rgb(96, 96, 96);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    background: linear-gradient(
      to bottom,
      #B2D1FF 0%,
      #80A7FF 50%,
      #3A7AB6 51%,
      #A8BEFF 100%
    );
    font-size: 13px;
  }

  .bar a {
    color: #0a1f4d;
    text-decoration: none;
  }

  main {
    background: #3F6589;
    color: #fff;
    padding: 20px;
    font-size: 17px;
    line-height: 1.55;
  }

  a { color: #B2D1FF; }

  h1 {
    margin: 0 0 4px;
    font-size: 24px;
    letter-spacing: 1px;
  }

  time {
    display: block;
    margin-bottom: 14px;
    font-size: 13px;
  }

  .rss-icon {
    width: 16px;
    height: 16px;
    vertical-align: -3px;
  }

  p { margin: 0; }
  p + p { margin-top: 14px; }

  pre {
    overflow-x: auto;
    padding: 12px;
  }

  img { max-width: 100%; }
</style>
