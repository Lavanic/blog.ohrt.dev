---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BlogLayout from "../../../../layouts/BlogLayout.astro";
import { getPosts, postParams } from "../../../../lib/posts";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: postParams(post), props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const shown = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BlogLayout title={post.data.title} description={post.data.description}>
  <article>
    <time datetime={post.data.date.toISOString()}>{shown}</time>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
</BlogLayout>

<style>
  h1 {
    font-size: 1.4em;
    line-height: 1.4;
    font-family: georgia, serif;
    letter-spacing: normal;
    margin: 0 0 0.8em 0;
  }

  time {
    margin-bottom: 4px;
  }

  /* narrow: standard footnotes at the bottom, margin copies hidden */
  article :global(.sidenote) {
    display: none;
  }

  article :global(.footnotes) {
    margin-top: 28px;
    padding-top: 10px;
    border-top: 1px solid #3F6589;
    font-size: 15px;
  }

  article :global(.footnotes h2) {
    margin: 0 0 6px;
    font-size: 15px;
  }

  article :global(.footnotes ol) {
    margin: 0;
    padding-left: 22px;
  }

  article :global([data-footnote-ref]) {
    text-decoration: none;
  }

  @media (min-width: 81rem) {
    article :global(.footnotes) {
      display: none;
    }

    article :global(.sidenote) {
      display: block;
      float: right;
      clear: right;
      position: relative;
      width: 15rem;
      margin: 4px calc(-15rem - 35px) 14px 0;
      font-size: 14px;
      line-height: 1.45;
    }

    article :global(.sidenote-num) {
      font-weight: bold;
      color: #B2D1FF;
    }

    article :global(.sidenote-p) {
      display: block;
    }

    article :global(.sidenote-p + .sidenote-p) {
      margin-top: 6px;
    }
  }
</style>
