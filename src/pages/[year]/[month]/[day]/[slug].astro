---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BlogLayout from "../../../../layouts/BlogLayout.astro";
import { getPosts, postParams, postUrl } from "../../../../lib/posts";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();
  const tagCounts = new Map<string, number>();
  for (const { data } of posts) {
    for (const tag of data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
  // posts are newest first, so "next" is the newer neighbour
  return posts.map((post, i) => ({
    params: postParams(post),
    props: {
      post,
      next: posts[i - 1],
      previous: posts[i + 1],
      tags: post.data.tags.map((tag) => ({ tag, count: tagCounts.get(tag) ?? 0 })),
    },
  }));
};

const { post, next, previous, tags } = Astro.props;
const { Content } = await render(post);
// "16th September 2026"
const { date } = post.data;
const day = date.getUTCDate();
const suffix =
  day % 100 >= 11 && day % 100 <= 13 ? "th"
  : ["th", "st", "nd", "rd"][day % 10] ?? "th";
const month = date.toLocaleDateString("en-US", { month: "long", timeZone: "UTC" });
const shown = `${day}${suffix} ${month} ${date.getUTCFullYear()}`;
---

<BlogLayout title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <Content />
    <footer>
      Posted <time datetime={date.toISOString()}>{shown}</time>
    </footer>
    <aside class="meta">
      <p>
        This is <strong>{post.data.title}</strong> by Oliver Ohrt, posted on {shown}.
      </p>
      {tags.length > 0 && (
        <p class="tags">
          {tags.map(({ tag, count }) => (
            <span class="tag">{tag} <span>{count}</span></span>
          ))}
        </p>
      )}
      <p>
        <strong>Next:</strong>{" "}
        {next ? <a href={postUrl(next)}>{next.data.title}</a> : "N/A"}
      </p>
      <p>
        <strong>Previous:</strong>{" "}
        {previous ? <a href={postUrl(previous)}>{previous.data.title}</a> : "N/A"}
      </p>
    </aside>
  </article>
</BlogLayout>

<script>
  // The meta box sits at the top of the right margin, so any sidenote
  // whose reference is level with it moves to the left margin instead.
  const article = document.querySelector("article");
  const meta = article?.querySelector<HTMLElement>(".meta");

  function placeSidenotes() {
    if (!article || !meta) return;
    const notes = article.querySelectorAll<HTMLElement>(".sidenote");
    notes.forEach((note) => note.classList.remove("sidenote-left"));
    if (getComputedStyle(meta).position !== "absolute") return;
    const clearOf = meta.getBoundingClientRect().bottom + 16;
    for (const note of notes) {
      const ref = note.previousElementSibling;
      if (ref && ref.getBoundingClientRect().top < clearOf) {
        note.classList.add("sidenote-left");
      }
    }
  }

  // re-run when images load or the window resizes
  if (article) new ResizeObserver(placeSidenotes).observe(article);
</script>

<style>
  h1 {
    font-size: 1.4em;
    line-height: 1.4;
    font-family: georgia, serif;
    letter-spacing: normal;
    margin: 0 0 0.8em 0;
  }

  footer {
    margin-top: 1em;
    padding-top: 0.5em;
    border-top: 1px solid #5580A8;
    font-size: 0.9em;
  }

  footer time {
    display: inline;
    margin: 0;
    font-size: inherit;
  }

  article :global(p) {
    margin: 0 0 0.8em 0;
  }

  article :global(h2),
  article :global(h3),
  article :global(h4) {
    margin: 1.2em 0 0.5em 0;
    font-family: georgia, serif;
    font-size: 1.2em;
    line-height: 1.4;
  }

  article :global(h4) {
    font-size: 1.1em;
  }

  article :global(a) {
    text-decoration: none;
    border-bottom: 1px solid;
  }

  article :global(a:hover),
  article :global(a:focus) {
    border-bottom-style: dotted;
  }

  article :global(a:has(> img)),
  article :global([data-footnote-ref]) {
    border-bottom: none;
  }

  article :global(ul),
  article :global(ol) {
    margin: 0 0 0.8em 0;
    padding: 0;
  }

  article :global(li) {
    margin-left: 1em;
    list-style-type: square;
  }

  article :global(ol li) {
    margin-left: 2em;
    list-style-type: decimal;
  }

  article :global(li li) {
    margin-bottom: 0.2em;
  }

  article :global(li li:first-of-type) {
    margin-top: 0.2em;
  }

  article :global(ul ul) {
    margin-bottom: 0;
  }

  /* left bar in our blue at the same 18% strength */
  article :global(blockquote) {
    margin: 1em 0;
    padding-left: 0.75em;
    border-left: 0.75em solid rgb(107 145 181 / 0.18);
  }

  article :global(blockquote blockquote) {
    border-left: none;
    padding-left: 1.5em;
  }

  article :global(pre) {
    margin: 1em 0;
    padding: 0.5em;
    border: 1px solid #3F6589;
    border-radius: 6px;
    line-height: 1.45;
    white-space: pre-wrap;
  }

  article :global(:not(pre) > code) {
    overflow-wrap: anywhere;
  }

  article :global(table) {
    margin: 1em 0;
    border-collapse: collapse;
  }

  article :global(th),
  article :global(td) {
    padding: 0.3em 0.5em 0.3em 0;
    font-size: 0.9em;
    text-align: left;
    vertical-align: top;
  }

  article :global(th) {
    border-bottom: 1px solid #5580A8;
  }

  /* narrow: the meta box follows the post */
  .meta {
    margin-top: 1.5em;
    font-size: 0.9em;
  }

  .tag {
    display: inline-block;
    margin: 0 0.3em 0.5em 0;
    padding: 4px 10px;
    border: 1px solid #3F6589;
    border-radius: 5px;
    background: #263340;
  }

  .tag span {
    font-size: 0.6em;
    vertical-align: middle;
    color: #A0B4C8;
  }

  /* narrow: standard footnotes at the bottom, margin copies hidden */
  article :global(.sidenote) {
    display: none;
  }

  article :global(.footnotes) {
    margin-top: 28px;
    padding-top: 10px;
    border-top: 1px solid #3F6589;
    font-size: 15px;
  }

  article :global(.footnotes h2) {
    margin: 0 0 6px;
    font-size: 15px;
  }

  article :global(.footnotes ol) {
    margin: 0;
  }

  article :global([data-footnote-ref]) {
    text-decoration: none;
  }

  @media (min-width: 81rem) {
    article {
      position: relative;
    }

    /* pinned to the top of the right margin, same column as sidenotes */
    .meta {
      position: absolute;
      top: 0;
      left: calc(100% + 35px);
      width: 15rem;
      margin: 0;
    }

    article :global(.footnotes) {
      display: none;
    }

    article :global(.sidenote) {
      display: block;
      float: right;
      clear: right;
      position: relative;
      width: 15rem;
      margin: 4px calc(-15rem - 35px) 14px 0;
      font-size: 14px;
      line-height: 1.45;
    }

    article :global(.sidenote-left) {
      float: left;
      clear: left;
      margin: 4px 0 14px calc(-15rem - 35px);
    }

    article :global(.sidenote-num) {
      font-weight: bold;
      color: #B2D1FF;
    }

    article :global(.sidenote-p) {
      display: block;
    }

    article :global(.sidenote-p + .sidenote-p) {
      margin-top: 6px;
    }
  }
</style>
