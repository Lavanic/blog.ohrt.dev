---
import BlogLayout from "../layouts/BlogLayout.astro";
import { getPosts, postUrl } from "../lib/posts";

const posts = await getPosts();
---

<BlogLayout title="blog.ohrt.dev">
  {posts.length === 0 ? (
    <p>Nothing published yet.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
          <a href={postUrl(post)}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BlogLayout>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    margin-top: 18px;
  }

  .posts time {
    display: block;
    margin: 0 0 2px;
  }

  .posts p {
    margin: 2px 0 0;
    font-size: 15px;
  }
</style>
